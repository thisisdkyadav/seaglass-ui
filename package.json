{
  "name": "seaglass-ui",
  "version": "0.1.0",
  "description": "Sea Glass — a React component library of frosted, tumbled-glass pebbles.",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "radix",
    "accessible",
    "sea-glass"
  ],
  "author": "Devesh Yadav",
  "license": "MIT",
  "homepage": "https://github.com/thisisdkyadav/seaglass#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisisdkyadav/seaglass.git"
  },
  "bugs": {
    "url": "https://github.com/thisisdkyadav/seaglass/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/seaglass.css"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:js && npm run build:types && npm run build:css",
    "build:js": "vite build",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "node scripts/build-css.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "vite --config site/vite.config.ts",
    "build:site": "vite build --config site/vite.config.ts",
    "preview:site": "vite preview --config site/vite.config.ts",
    "example:dashboard": "vite --config examples/dashboard/vite.config.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.40.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sugar-high": "^2.6.0",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
